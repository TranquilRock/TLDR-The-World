[MASTER]
init-hook='import sys; sys.path.insert(0, "/Users/andy/Documents/TLDR-The-World")'

[MESSAGES CONTROL]
disable=
    missing-docstring,
    line-too-long,
    protected-access,

[DESIGN]
max-args=5
max-attributes=7
max-branches=12
max-locals=15
max-parents=7
max-public-methods=20
max-returns=6
max-statements=50

[FORMAT]
max-line-length=88
indent-string='    '
