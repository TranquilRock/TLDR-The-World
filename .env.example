# GitHub Models API token (required)
# Obtain from: https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=your_github_models_token_here

# Telegram Bot token (required)
# Obtain from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (required)
# The chat or channel ID to send messages to
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LLM Model to use (optional, defaults to gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# GitHub Models API base URL (optional, defaults to https://models.inference.ai.azure.com)
# GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com

# Alternate env var name supported for the models token: MODELS_API_TOKEN
# MODELS_API_TOKEN=your_models_api_token_here

# Retry / backoff settings (optional):
# GITHUB_MODELS_RETRY_MAX_ATTEMPTS=3
# GITHUB_MODELS_RETRY_BACKOFF_BASE_SECONDS=0.5
# GITHUB_MODELS_RETRY_BACKOFF_MAX_SECONDS=8.0
